{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "truco-argentino-multiplayer",
  "main": "src/index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRUCO_ROOMS",
        "class_name": "TrucoRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TrucoRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jxdxv.github.io"
  }
}
