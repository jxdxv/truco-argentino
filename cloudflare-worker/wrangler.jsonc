{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "truco-argentino-multiplayer",
	"main": "src/index.js",
	"compatibility_date": "2026-11-06",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "TRUCO_ROOMS",
				"class_name": "TrucoRoom"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "truco-argentino-db",
			"database_id": "1f7692f0-83c3-4357-a9d0-0164b4b893e7",
			"migrations_dir": "migrations"
		},
		{
			"binding": "truco_argentino_db",
			"database_name": "truco-argentino-db",
			"database_id": "1f7692f0-83c3-4357-a9d0-0164b4b893e7",
			"remote": true
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"TrucoRoom"
			]
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://jxdxv.github.io"
	}
}